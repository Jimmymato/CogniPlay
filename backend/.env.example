# ============================================================
# CogniPlay — Backend — Variables de entorno
# Copiar este archivo a `.env` y completar los valores.
# ============================================================

# URL de conexión a PostgreSQL.
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_base_datos
# La lee el CLI de Prisma (vía prisma.config.ts) y el servidor en tiempo
# de ejecución (vía el adaptador @prisma/adapter-pg en src/config/prisma.ts).
DATABASE_URL=postgresql://postgres:contraseña@localhost:5432/cogniplay

# Puerto donde escucha el servidor Express.
# Opcional: si se omite, usa 4000. El frontend espera este puerto
# en su VITE_API_URL (http://localhost:4000/api).
PORT=4000

# Clave secreta para firmar los tokens JWT.
# Obligatoria. Usar una cadena larga y aleatoria; por ejemplo, generarla con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Nunca reutilizar la de otro entorno ni subirla al repositorio.
JWT_SECRET=

# Tiempo de vigencia del token JWT.
# Opcional: si se omite, usa 7d. Ejemplos de valores: 7d, 24h, 60m.
JWT_EXPIRACION=7d

# Orígenes permitidos para CORS, separados por coma (sin barra final).
# Opcional: si se omite, se aceptan peticiones desde cualquier origen
# (cómodo en desarrollo local, NO recomendado en producción).
# Ejemplo: CORS_ORIGEN=http://localhost:5173,https://cogniplay.ejemplo.com
CORS_ORIGEN=
